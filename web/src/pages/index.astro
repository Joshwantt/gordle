---
const keyboardRows = [
  ["q", "w", "e", "r", "t", "y", "u", "i", "o", "p"],
  ["a", "s", "d", "f", "g", "h", "j", "k", "l"],
  ["enter", "z", "x", "c", "v", "b", "n", "m", "backspace"],
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>Gordle</title>
  </head>
  <body>
    <header>
      <h1>Gordle</h1>
      <button id="new-game" type="button">
        New game
      </button>
    </header>

    <main>
      <div id="toast" role="status" aria-live="polite"></div>
      <div id="board"></div>
    </main>

    <div id="keyboard">
      {keyboardRows.map((row, rowIndex) => (
        <div class="keyboard-row">
          {rowIndex === 1 && <div class="spacer" />}
          {row.map((key) => (
            <button
              type="button"
              class:list={["key", { wide: key.length > 1 }]}
              data-key={key}
              aria-label={key.length > 1 ? key : undefined}
            >
              {key === "backspace" ? (
                <svg
                  viewBox="0 0 24 24"
                  width="24"
                  height="24"
                  aria-hidden="true"
                >
                  <path
                    fill="currentColor"
                    d="M22 3H7c-.69 0-1.23.35-1.59.88L0 12l5.41 8.11c.36.53.9.89 1.59.89h15c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H7.07L2.4 12l4.66-7H22v14zm-11.59-2L14 13.41 17.59 17 19 15.59 15.41 12 19 8.41 17.59 7 14 10.59 10.41 7 9 8.41 12.59 12 9 15.59z"
                  />
                </svg>
              ) : (
                key
              )}
            </button>
          ))}
          {rowIndex === 1 && <div class="spacer" />}
        </div>
      ))}
    </div>

    <script>
      import "../scripts/game.ts";
    </script>
  </body>
</html>

<style is:global>
  :root {
    --color-background: #ffffff;
    --color-text: #1a1a1b;
    --color-tile-border: #d3d6da;
    --color-tile-border-filled: #878a8c;
    --color-key: #d3d6da;
    --color-key-text: #1a1a1b;
    --color-correct: #6aaa64;
    --color-present: #c9b458;
    --color-absent: #787c7e;
    --color-revealed-text: #ffffff;
    --color-toast: #1a1a1b;
    --color-toast-text: #ffffff;
    --color-divider: #d3d6da;
  }

  @media (prefers-color-scheme: dark) {
    :root {
      --color-background: #121213;
      --color-text: #ffffff;
      --color-tile-border: #3a3a3c;
      --color-tile-border-filled: #565758;
      --color-key: #818384;
      --color-key-text: #ffffff;
      --color-correct: #538d4e;
      --color-present: #b59f3b;
      --color-absent: #3a3a3c;
      --color-toast: #ffffff;
      --color-toast-text: #1a1a1b;
      --color-divider: #3a3a3c;
    }
  }

  * {
    box-sizing: border-box;
  }

  html,
  body {
    margin: 0;
    height: 100%;
  }

  body {
    display: flex;
    flex-direction: column;
    height: 100dvh;
    background: var(--color-background);
    color: var(--color-text);
    font-family: "Helvetica Neue", Arial, sans-serif;
    -webkit-tap-highlight-color: transparent;
  }

  button {
    font: inherit;
    color: inherit;
    cursor: pointer;
  }

  header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 52px;
    padding: 0 16px;
    border-bottom: 1px solid var(--color-divider);
  }

  h1 {
    margin: 0;
    font-size: 1.75rem;
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  #new-game {
    padding: 6px 12px;
    border: 1px solid var(--color-tile-border-filled);
    border-radius: 4px;
    background: transparent;
    font-size: 0.875rem;
    font-weight: 600;
  }

  main {
    position: relative;
    flex: 1;
    display: grid;
    place-items: center;
    padding: 12px;
    container-type: size;
    min-height: 0;
  }

  /* tiles scale to fit both the width and height of main, whatever the grid dimensions */
  #board {
    --gap: 5px;
    --tile: min(
      62px,
      (100cqw - (var(--columns) - 1) * var(--gap)) / var(--columns),
      (100cqh - (var(--rows) - 1) * var(--gap)) / var(--rows)
    );
    display: grid;
    gap: var(--gap);
  }

  .row {
    display: grid;
    grid-template-columns: repeat(var(--columns), var(--tile));
    gap: var(--gap);
  }

  .tile {
    --tile-color: transparent;
    --tile-border: var(--color-tile-border);
    --tile-text: var(--color-text);
    display: grid;
    place-items: center;
    width: var(--tile);
    height: var(--tile);
    border: 2px solid var(--tile-border);
    background: var(--tile-color);
    color: var(--tile-text);
    font-size: calc(var(--tile) * 0.55);
    font-weight: 700;
    line-height: 1;
    text-transform: uppercase;
    user-select: none;
  }

  .tile[data-state="filled"] {
    --tile-border: var(--color-tile-border-filled);
    animation: pop 100ms ease-out;
  }

  .tile[data-state="correct"],
  .tile[data-state="present"],
  .tile[data-state="absent"] {
    --tile-border: var(--tile-color);
    --tile-text: var(--color-revealed-text);
  }
  .tile[data-state="correct"] {
    --tile-color: var(--color-correct);
  }
  .tile[data-state="present"] {
    --tile-color: var(--color-present);
  }
  .tile[data-state="absent"] {
    --tile-color: var(--color-absent);
  }

  /* each tile flips in turn, switching to its result colour while edge-on */
  .row.reveal .tile {
    animation: flip 500ms ease-in-out backwards;
    animation-delay: calc(var(--index) * 250ms);
  }

  .row.shake {
    animation: shake 400ms ease-in-out;
  }

  @keyframes pop {
    50% {
      transform: scale(1.1);
    }
  }

  @keyframes flip {
    0% {
      transform: rotateX(0);
      background: transparent;
      border-color: var(--color-tile-border-filled);
      color: var(--color-text);
    }
    50% {
      transform: rotateX(90deg);
      background: transparent;
      border-color: var(--color-tile-border-filled);
      color: var(--color-text);
    }
    50.01% {
      background: var(--tile-color);
      border-color: var(--tile-color);
      color: var(--tile-text);
    }
    100% {
      transform: rotateX(0);
    }
  }

  @keyframes shake {
    10%,
    90% {
      transform: translateX(-1px);
    }
    20%,
    80% {
      transform: translateX(2px);
    }
    30%,
    50%,
    70% {
      transform: translateX(-4px);
    }
    40%,
    60% {
      transform: translateX(4px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tile,
    .row {
      animation: none !important;
    }
  }

  #toast {
    position: absolute;
    top: 8px;
    left: 50%;
    z-index: 1;
    transform: translateX(-50%);
    padding: 12px 16px;
    border-radius: 4px;
    background: var(--color-toast);
    color: var(--color-toast-text);
    font-weight: 700;
    white-space: nowrap;
    pointer-events: none;
    opacity: 0;
    transition: opacity 150ms;
  }

  #toast.visible {
    opacity: 1;
  }

  #keyboard {
    display: grid;
    gap: 8px;
    width: 100%;
    max-width: 500px;
    margin: 0 auto;
    padding: 0 8px 8px;
  }

  .keyboard-row {
    display: flex;
    gap: 6px;
  }

  .spacer {
    flex: 0.5;
  }

  .key {
    flex: 1;
    display: grid;
    place-items: center;
    height: min(58px, 8dvh);
    padding: 0;
    border: 0;
    border-radius: 4px;
    background: var(--color-key);
    color: var(--color-key-text);
    font-size: 1.25rem;
    font-weight: 700;
    text-transform: uppercase;
    user-select: none;
  }

  .key.wide {
    flex: 1.5;
    font-size: 0.75rem;
  }

  .key[data-state] {
    color: var(--color-revealed-text);
  }
  .key[data-state="correct"] {
    background: var(--color-correct);
  }
  .key[data-state="present"] {
    background: var(--color-present);
  }
  .key[data-state="absent"] {
    background: var(--color-absent);
  }
</style>
